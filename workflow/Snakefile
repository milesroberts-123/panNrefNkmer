# load packages

import pandas as pd
import os
from snakemake.utils import min_version

min_version("9.5.1")

# configuration
configfile: "../config/config.yaml"

# load samples
reads = pd.read_table(
    "../config/samples_medium.tsv", sep="\t", dtype={"Run": str}
).set_index(["Run"], drop=False)

# Define rules too fast to bother with cluster submission
localrules: all, batch_per_sample

rule jules_only:
    input:
        expand("results/psmc/{srr}.psmc", srr = reads["Run"]),
        expand("results/roh/{srr}_ROH.txt", srr = reads["Run"])

# ROH only, no PSMC -- jules_only pulls in both since PSMC and ROH share
# the same upstream chain through mark_reads/coverage, but ROH's own path
# from there (bcftools mpileup -> filter -> roh) doesn't touch the PSMC-
# specific steps (50k bed subset, consensus calling, psmc itself), so this
# skips real work when you only want ROH.
rule jules_roh_only:
    input:
        expand("results/roh/{srr}_ROH.txt", srr = reads["Run"])

# Audits every already-downloaded sample's raw_reads for gzip corruption
# (jules_verify_raw_reads), without downloading anything new. Run with
# --keep-going: samples that fail have their corrupt raw_reads r1/r2 deleted
# as a side effect, so a later run of jules_only/jules_roh_only/
# jules_msmc2_only will see those files missing and have jules_fastq_dump
# redownload just the failed samples -- no need to track which ones failed
# by hand.
rule jules_verify_downloads_only:
    input:
        expand("results/raw_reads/{srr}.verified", srr = reads["Run"])

# Not part of jules_only -- MSMC2 track is drafted/reviewed but not yet
# run end-to-end even once. Kept as a separate target until it's proven
# out, the same way jules_only itself is kept out of `all`.
rule jules_msmc2_only:
    input:
        expand("results/msmc2/{srr}/msmc2.final.txt", srr = reads["Run"])

rule kmers_only:
    input:
        expand("results/batch_tracker/{species}.done", species = reads["Species"].unique())

rule kmers_subset_only:
    input:
        expand("results/subset/kmer_distances/{species}.txt", species = reads["Species"].unique())

rule kmers_nofilt_only:
    input:
        expand("results/nofilt/batch_tracker/{species}.done", species = reads["Species"].unique())

rule kmers_kraken_only:
    input:
        expand("results/kraken/batch_tracker/{species}.done", species = reads["Species"].unique())

rule batch_per_species:
    input:
        "results/kmer_distances_{species}.txt",
        "results/paste/{species}.txt.gz",
        "results/kmc_histo/{species}.txt",
        "results/subset/kmer_distances/{species}.txt",
        expand("results/fastp/post_trim/{ID}.json", ID=lookup(query="Species == '{species}'", within=reads, cols="Run")),
        expand("results/fastp/post_rm_contam/{ID}.json", ID=lookup(query="Species == '{species}'", within=reads, cols="BioSample"))
    output:
        touch("results/batch_tracker/{species}.done")

## Jules branch
include: "rules/jules_v2.smk"
include: "rules/jules_msmc2.smk"

## Data download and QC rules
include: "rules/data_download.smk"
include: "rules/fastp.smk"

## K-mer counting rules
include: "rules/common.smk"
include: "rules/kmc.smk"
include: "rules/cbf.smk"
include: "rules/subset.smk"

## No-filter k-mer branch (no reference contamination removal)
include: "rules/kmc_nofilt.smk"

## Kraken2 microbial filter + k-mer branch
include: "rules/kraken2.smk"
include: "rules/kmc_kraken.smk"
